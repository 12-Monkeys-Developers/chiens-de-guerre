<section class="item-body">

  <div class="field-line">
    <label>{{localize "CDG.label.long.subtype"}}</label>
    <select name="system.subtype">
      {{selectOptions choiceSubtypes selected=system.subtype localize=true labelAttr="label" valueAttr="id"}}
    </select>
  </div>

  {{#if (or isWeapon isArmor isShield)}}
    <div class="field-line">
      <label>{{localize "CDG.label.long.category"}}</label>
      <select name="system.category">
        {{selectOptions choiceCategories selected=system.category blank="" localize=true labelAttr="label" valueAttr="id"}}
      </select>
    </div>
  {{/if}}

  {{#if isWeapon}}
    <div class="field-line attack-test-line">
      <label>{{localize "CDG.label.long.attackTest"}}</label>
      <select name="system.attack.ability">
        {{selectOptions choiceAbilities selected=system.attack.ability localize=true labelAttr="label" valueAttr="id"}}
      </select>
      <span>/</span>
      <select name="system.attack.skill">
        {{selectOptions choiceSkills selected=system.attack.skill localize=true labelAttr="label" valueAttr="id"}}
      </select>
    </div>
    <div class="field-line rank-line">
      <label>{{localize "CDG.label.long.damage"}}</label>
      {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
          path="system.damage.rank" rank=system.damage.rank editable=isEditable}}
    </div>
  {{/if}}

  {{#if isArmor}}
    <div class="field-line rank-line">
      <label>{{localize "CDG.label.long.protection"}}</label>
      {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
          path="system.protection.rank" rank=system.protection.rank editable=isEditable}}
    </div>
    <p class="hint">{{localize "CDG.ui.armorCategoryHint"}}</p>
  {{/if}}

  {{#if isShield}}
    <div class="field-line">
      <label>{{localize "CDG.label.long.blockBonus"}}</label>
      <input type="number" name="system.blockBonus" value="{{system.blockBonus}}" data-dtype="Number" />
    </div>
  {{/if}}

  {{#if (or isArmor isShield)}}
    <div class="field-line">
      <label>{{localize "CDG.label.long.initMalus"}}</label>
      <input type="number" name="system.initMalus" value="{{system.initMalus}}" max="0" data-dtype="Number" />
    </div>
  {{/if}}

  <div class="field-line">
    <label>{{localize "CDG.label.long.quantity"}}</label>
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" data-dtype="Number" />
  </div>

  <div class="field-line price-line">
    <label>{{localize "CDG.label.long.price"}}</label>
    {{#each currencies as |currency|}}
      <span class="price-part">
        <input type="number" name="system.price.{{currency.id}}" value="{{lookup @root.system.price currency.id}}" min="0" data-dtype="Number" />
        <span class="unit">{{localize currency.abbreviation}}</span>
      </span>
    {{/each}}
  </div>

  {{> "systems/chiens-de-guerre/templates/items/shared/description.hbs"}}

</section>
