<section class="tab tab-rank1{{#if tabs.rank1.active}} active{{/if}}" data-group="primary" data-tab="rank1">
  <section class="item-body">

    <div class="field-line rank-name">
      <input type="text" name="system.rankData.name1" value="{{system.rankData.name1}}" spellcheck="false" />
    </div>

    {{!-- Le tour ne coûte de l'Esprit qu'aux mystiques, et le livre fait payer certaines
          allégeances plus cher que d'autres : un montant par voie. --}}
    {{#unless isPassive}}
      <div class="field-line cost-line">
        <label>{{localize "CDG.label.long.activationCost"}}</label>
        {{#each allegiances as |allegiance|}}
          <span class="cost-part">
            <input type="number" name="system.rankData.cost1.{{allegiance.id}}"
              value="{{lookup @root.system.rankData.cost1 allegiance.id}}" min="0" data-dtype="Number" />
            <span class="unit">{{localize allegiance.label}}</span>
          </span>
        {{/each}}
      </div>
    {{/unless}}

    {{!-- Ce que le tour fait, indépendamment de la voie suivie. --}}
    <div class="free-text rank-effect">
      {{formInput systemFields.rankData.fields.effect1 value=system.rankData.effect1 enriched=enrichedEffect1 name="system.rankData.effect1" toggled=true}}
    </div>

    {{!-- Deux variantes, dont l'intitulé se recopie du livre : « Lumière / Balance »,
          « Obscurité », ou tout autre regroupement selon le pouvoir. --}}
    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label1a" value="{{system.rankData.label1a}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect1a value=system.rankData.effect1a enriched=enrichedEffect1a name="system.rankData.effect1a" toggled=true}}
      </div>
    </section>

    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label1b" value="{{system.rankData.label1b}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect1b value=system.rankData.effect1b enriched=enrichedEffect1b name="system.rankData.effect1b" toggled=true}}
      </div>
    </section>

  </section>
</section>
