<section class="item-body">

  <div class="field-line">
    <label>{{localize "CDG.label.long.abilityBonus"}}</label>
    <select name="system.abilityBonus">
      {{selectOptions choiceAbilities selected=system.abilityBonus blank="" localize=true labelAttr="label" valueAttr="id"}}
    </select>
  </div>

  <section class="features">
    <h2 class="section-title">{{localize "CDG.label.long.grantedFeatures"}}</h2>
    <ul class="item-list">
      {{#each features as |feature|}}
        <li class="item-row" data-uuid="{{feature.uuid}}">
          <img class="item-img" src="{{feature.img}}" />
          <span class="item-name">{{feature.name}}</span>
          {{#if @root.isEditable}}
            <a class="item-control" data-action="removeFeature" data-uuid="{{feature.uuid}}"
              data-tooltip="{{localize 'CDG.ui.remove'}}"><i class="fas fa-xmark"></i></a>
          {{/if}}
        </li>
      {{else}}
        <li class="empty">{{localize "CDG.ui.dropFeaturesHere"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="languages">
    <h2 class="section-title">{{localize "CDG.label.long.startingLanguages"}}</h2>
    <ul class="language-list">
      {{#each languages as |language|}}
        <li class="language">
          <a class="box {{#if language.known}}checked{{/if}}" data-action="toggleLanguage" data-language="{{language.id}}"></a>
          <span>{{localize language.label}}</span>
        </li>
      {{/each}}
    </ul>
  </section>

  {{> "systems/chiens-de-guerre/templates/items/shared/description.hbs"}}

</section>
