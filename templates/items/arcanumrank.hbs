{{!-- Un onglet de rang, rendu trois fois : `spell` vient de `_preparePartContext`. --}}
<section class="tab tab-{{spell.tab}}{{#if spell.active}} active{{/if}}" data-group="primary" data-tab="{{spell.tab}}">
  <section class="item-body">

    <div class="field-line rank-name">
      <input type="text" name="{{spell.path}}.name" value="{{spell.data.name}}" spellcheck="false" />
    </div>

    {{!-- Le tour ne coûte de l'Esprit qu'aux mystiques, et le livre fait payer certaines
          allégeances plus cher que d'autres : un montant par voie. --}}
    {{#unless isPassive}}
      <div class="field-line cost-line">
        <label>{{localize "CDG.label.long.activationCost"}}</label>
        {{#each allegiances as |allegiance|}}
          <span class="cost-part">
            <input type="number" name="{{@root.spell.path}}.cost.{{allegiance.id}}"
              value="{{lookup @root.spell.data.cost allegiance.id}}" min="0" data-dtype="Number" />
            <span class="unit">{{localize allegiance.label}}</span>
          </span>
        {{/each}}
      </div>
    {{/unless}}

    {{!-- Ce que le tour fait, indépendamment de la voie suivie. --}}
    <div class="free-text rank-effect">
      {{formInput spell.fields.effect value=spell.data.effect enriched=spell.enrichedEffect name=spell.effectName toggled=true}}
    </div>

    {{!-- Deux variantes, dont l'intitulé se recopie du livre : « Lumière / Balance »,
          « Obscurité », ou tout autre regroupement selon le pouvoir. --}}
    {{#each spell.variants as |variant|}}
      <section class="variant">
        <input class="variant-label" type="text" name="{{variant.path}}.label" value="{{variant.label}}"
          placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
        <div class="free-text">
          {{formInput variant.field value=variant.effect enriched=variant.enriched name=variant.effectName toggled=true}}
        </div>
      </section>
    {{/each}}

  </section>
</section>
