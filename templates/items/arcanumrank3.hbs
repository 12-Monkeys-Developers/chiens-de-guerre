<section class="tab tab-rank3{{#if tabs.rank3.active}} active{{/if}}" data-group="primary" data-tab="rank3">
  <section class="item-body">

    <div class="field-line rank-name">
      <input type="text" name="system.rankData.name3" value="{{system.rankData.name3}}" spellcheck="false" />
    </div>

    {{!-- Le tour ne coûte de l'Esprit qu'aux mystiques, et le livre fait payer certaines
          allégeances plus cher que d'autres : un montant par voie. --}}
    {{#unless isPassive}}
      <div class="field-line cost-line">
        <label>{{localize "CDG.label.long.activationCost"}}</label>
        {{#each allegiances as |allegiance|}}
          <span class="cost-part">
            <input type="number" name="system.rankData.cost3.{{allegiance.id}}"
              value="{{lookup @root.system.rankData.cost3 allegiance.id}}" min="0" data-dtype="Number" />
            <span class="unit">{{localize allegiance.label}}</span>
          </span>
        {{/each}}
      </div>
    {{/unless}}

    {{!-- Ce que le tour fait, indépendamment de la voie suivie. --}}
    <div class="free-text rank-effect">
      {{formInput systemFields.rankData.fields.effect3 value=system.rankData.effect3 enriched=enrichedEffect3 name="system.rankData.effect3" toggled=true}}
    </div>

    {{!-- Deux variantes, dont l'intitulé se recopie du livre : « Lumière / Balance »,
          « Obscurité », ou tout autre regroupement selon le pouvoir. --}}
    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label3a" value="{{system.rankData.label3a}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect3a value=system.rankData.effect3a enriched=enrichedEffect3a name="system.rankData.effect3a" toggled=true}}
      </div>
    </section>

    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label3b" value="{{system.rankData.label3b}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect3b value=system.rankData.effect3b enriched=enrichedEffect3b name="system.rankData.effect3b" toggled=true}}
      </div>
    </section>

  </section>
</section>
