<section class="tab tab-rank2{{#if tabs.rank2.active}} active{{/if}}" data-group="primary" data-tab="rank2">
  <section class="item-body">

    <div class="field-line rank-name">
      <input type="text" name="system.rankData.name2" value="{{system.rankData.name2}}" spellcheck="false" />
    </div>

    {{!-- Le tour ne coûte de l'Esprit qu'aux mystiques, et le livre fait payer certaines
          allégeances plus cher que d'autres : un montant par voie. --}}
    {{#unless isPassive}}
      <div class="field-line cost-line">
        <label>{{localize "CDG.label.long.activationCost"}}</label>
        {{#each allegiances as |allegiance|}}
          <span class="cost-part">
            <input type="number" name="system.rankData.cost2.{{allegiance.id}}"
              value="{{lookup @root.system.rankData.cost2 allegiance.id}}" min="0" data-dtype="Number" />
            <span class="unit">{{localize allegiance.label}}</span>
          </span>
        {{/each}}
      </div>
    {{/unless}}

    {{!-- Ce que le tour fait, indépendamment de la voie suivie. --}}
    <div class="free-text rank-effect">
      {{formInput systemFields.rankData.fields.effect2 value=system.rankData.effect2 enriched=enrichedEffect2 name="system.rankData.effect2" toggled=true}}
    </div>

    {{!-- Deux variantes, dont l'intitulé se recopie du livre : « Lumière / Balance »,
          « Obscurité », ou tout autre regroupement selon le pouvoir. --}}
    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label2a" value="{{system.rankData.label2a}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect2a value=system.rankData.effect2a enriched=enrichedEffect2a name="system.rankData.effect2a" toggled=true}}
      </div>
    </section>

    <section class="variant">
      <input class="variant-label" type="text" name="system.rankData.label2b" value="{{system.rankData.label2b}}"
        placeholder="{{localize 'CDG.arcanum.variantPlaceholder'}}" spellcheck="false" />
      <div class="free-text">
        {{formInput systemFields.rankData.fields.effect2b value=system.rankData.effect2b enriched=enrichedEffect2b name="system.rankData.effect2b" toggled=true}}
      </div>
    </section>

  </section>
</section>
