<section class="cdg info flexcol">
  <img class="logo" src="systems/chiens-de-guerre/ui/logo_cdg.webp" alt="{{localize 'CDG.sidebar.title'}}" />
  <p class="subtitle version">{{version}}</p>
</section>

<section class="cdg tools flexcol">
  <h4 class="divider">{{localize "CDG.sidebar.menu"}}</h4>
  {{#if isGM}}
    <button type="button" class="button" data-action="openApp" data-app="party" data-tooltip="{{localize 'CDG.sidebar.partyOverviewTooltip'}}">
      <i class="fa-solid fa-users" inert></i>
      {{localize "CDG.party.title"}}
    </button>
  {{/if}}
  {{#if canCreateActor}}
    <button type="button" class="button" data-action="openApp" data-app="character-creation" data-tooltip="{{localize 'CDG.sidebar.characterCreationTooltip'}}">
      <i class="fa-solid fa-user-plus" inert></i>
      {{localize "CDG.creation.title"}}
    </button>
    <button type="button" class="button" data-action="openApp" data-app="company-creation" data-tooltip="{{localize 'CDG.sidebar.companyCreationTooltip'}}">
      <i class="fa-solid fa-flag" inert></i>
      {{localize "CDG.companyCreation.title"}}
    </button>
  {{else}}
    <p class="hint">{{localize "CDG.sidebar.noCreatePermission"}}</p>
  {{/if}}
</section>
