<div class="compagnie-body">

  <div class="compagnie-top">
    <section class="roster-pj" data-roster="pj">
      <h2 class="section-title">
        {{localize "CDG.label.long.rosterPJ"}}
        {{#if unlocked}}<a data-action="addRosterEntry" data-tooltip="{{localize 'CDG.ui.add'}}"><i class="fas fa-plus"></i></a>{{/if}}
      </h2>
      <ul class="item-list">
        {{#each rosterPJ as |entry|}}
          {{> "systems/chiens-de-guerre/templates/actors/partials/compagnie-roster-row.hbs" entry=entry roster="pj"}}
        {{else}}
          <li class="empty">{{localize "CDG.company.noRoster"}}</li>
        {{/each}}
      </ul>
    </section>

    <section class="roster-pnj" data-roster="pnj">
      <h2 class="section-title">
        {{localize "CDG.label.long.rosterPNJ"}}
        {{#if unlocked}}<a data-action="addRosterEntry" data-tooltip="{{localize 'CDG.ui.add'}}"><i class="fas fa-plus"></i></a>{{/if}}
      </h2>
      <ul class="item-list">
        {{#each rosterPNJ as |entry|}}
          {{> "systems/chiens-de-guerre/templates/actors/partials/compagnie-roster-row.hbs" entry=entry roster="pnj"}}
        {{else}}
          <li class="empty">{{localize "CDG.company.noRoster"}}</li>
        {{/each}}
      </ul>
    </section>
  </div>

  <section class="company-rest">
    <h2 class="section-title">{{localize "CDG.company.healing.title"}}</h2>
    <div class="company-healing-actions">
      <button type="button" data-action="companyHealing" data-healing="recovery" {{disabled (or dissolved (not hasWounds))}}>
        <i class="fa-solid fa-heart-pulse" inert></i> {{localize "CDG.company.healing.recovery"}}
      </button>
      <button type="button" data-action="companyHealing" data-healing="care" {{disabled (or dissolved (not hasWounds))}}>
        <i class="fa-solid fa-kit-medical" inert></i> {{localize "CDG.company.healing.care"}}
      </button>
    </div>
    <h3>{{localize "CDG.company.healing.reserves"}}</h3>
    <div class="rest-buttons">
      {{#each choiceRestConditions as |condition|}}
        <button type="button" class="rest-button" data-action="rest" data-condition="{{condition.id}}" {{disabled @root.dissolved}}
          <span>{{localize condition.label}}</span><strong>+{{condition.recovery}}</strong>
        </button>
      {{/each}}
    </div>
  </section>

  <section class="chronicles">
    <h2 class="section-title">
      {{localize "CDG.label.long.chronicles"}}
      {{#if unlocked}}<a data-action="addChronicle" data-tooltip="{{localize 'CDG.ui.add'}}"><i class="fas fa-plus"></i></a>{{/if}}
    </h2>
    <ul class="item-list">
      {{#each chronicles as |chronicle|}}
        {{> "systems/chiens-de-guerre/templates/actors/partials/compagnie-chronicle-row.hbs" entry=chronicle}}
      {{else}}
        <li class="empty">{{localize "CDG.company.noChronicles"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="notes-section">
    <h2 class="section-title">{{localize "CDG.label.long.notes"}}</h2>
    <div class="free-text">
      {{formInput systemFields.notes value=system.notes enriched=enrichedNotes name="system.notes" toggled=true}}
    </div>
  </section>

</div>
