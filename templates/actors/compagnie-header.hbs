{{!
  En-tête compact, commun aux trois onglets : l'emblème, le nom, et l'état de la compagnie qu'on
  consulte en jouant — les trois réserves et le malus courant des blessés.
}}
<header class="sheet-header compagnie-header">
  <div class="portrait">
    <img class="actor-img" src="{{actor.img}}" data-tooltip="{{actor.name}}"
      {{#if unlocked}}data-action="editImage" data-edit="img"{{/if}} />
  </div>

  <div class="compagnie-identity">
    <div class="name-line">
      {{#if unlocked}}
        <input type="text" name="name" value="{{actor.name}}" spellcheck="false" />
      {{else}}
        <span class="value name">{{actor.name}}</span>
      {{/if}}
    </div>

    <ul class="company-status">
      {{#each companyAbilities as |ability id|}}
        {{#with (lookup @root.abilities id) as |pool|}}
          <li class="status-pool">
            <span class="status-label">{{localize ability.label}}</span>
            <strong>{{pool.value}}</strong><span class="status-max">/ {{pool.max}}</span>
          </li>
        {{/with}}
      {{/each}}
      <li class="status-malus{{#if wounds.malus}} wounded{{/if}}">
        <span class="status-label">{{localize "CDG.label.long.currentWoundMalus"}}</span>
        <strong>{{signed wounds.malus}}</strong>
      </li>
    </ul>

    {{#if dissolved}}
      <p class="warning">{{localize "CDG.company.dissolved"}}</p>
      {{#if unlocked}}
        <button type="button" class="reactivate" data-action="reactivate">{{localize "CDG.company.reactivate"}}</button>
      {{/if}}
    {{/if}}
  </div>
</header>
