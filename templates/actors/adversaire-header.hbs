<header class="adversaire-header">
  <div class="banner">
    <div class="portrait">
      <img class="actor-img" src="{{actor.img}}" data-tooltip="{{actor.name}}"
        {{#if unlocked}}data-action="editImage" data-edit="img"{{/if}} />
    </div>
  </div>
  <div class="identity">
    <div class="adversaire-nameline">
      {{#if unlocked}}
        <input type="text" name="name" value="{{actor.name}}" spellcheck="false" />
      {{else}}
        <span class="value name">{{actor.name}}</span>
      {{/if}}
    </div>
    {{#if (or unlocked system.major)}}<label class="major-npc">
      <input type="checkbox" name="system.major" {{checked system.major}} {{#unless unlocked}}disabled{{/unless}} />
      {{localize "CDG.label.long.majorNpc"}}
    </label>{{/if}}
  </div>

  <div class="abilities-line">
    {{#each adversaireAbilities as |ability|}}
      {{#with (lookup @root.abilities ability.id) as |pool|}}
        <div class="ability draggable" data-ability="{{ability.id}}" data-cdg-macro="test">
          <span class="ability-name" data-action="rollTest" data-tooltip="{{localize 'CDG.roll.title'}}">{{localize ability.label}} :</span>
          <div class="pool">
            {{#if @root.unlocked}}
              <input class="pool" type="number" name="system.abilities.{{ability.id}}.value" value="{{pool.value}}" min="0" data-dtype="Number"
                {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips ability.id}}"{{/if}} />
            {{else}}
            <span class="pool-value">{{pool.value}}</span>
            {{/if}}
                {{#if @root.system.major}}
            <span class="pool-separator">/</span>
            {{#if @root.unlocked}}
              <input class="pool-max" type="number" name="system.abilities.{{ability.id}}.max" value="{{pool.baseMax}}" min="0" data-dtype="Number"
                {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips ability.id}}"{{/if}} />
            {{else}}
              <span class="pool-max" {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips ability.id}}"{{/if}}>{{pool.max}}</span>
            {{/if}}
            {{/if}}
            </div>
        </div>
      {{/with}}
    {{/each}}
  </div>
  <div class="npc-skills">
  {{#if hasSkills}}
    <div class="skill-columns">
      {{#each skillColumns as |column|}}<ul class="skill-column">
        {{#each column as |skill|}}<li class="skill{{#if @root.unlocked}} draggable{{/if}}" data-skill="{{skill.id}}" data-cdg-macro="test">
          <span class="skill-name" data-action="rollTest" data-tooltip="{{localize 'CDG.roll.title'}}">{{localize skill.label}}</span>
          {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs" path=(concat "system.skills." skill.id ".rank") rank=(lookup (lookup @root.skills skill.id) "rank") editable=@root.unlocked}}
        </li>{{/each}}
      </ul>{{/each}}
    </div>
  {{else}}<p class="empty">{{localize "CDG.ui.noSkill"}}</p>{{/if}}
  </div>
  
  <div class="wounds-line">
    {{#each woundLevels as |level|}}
    {{#with (lookup @root.wounds level.id) as |wound|}}
      <div class="wound-level">
        <label class="wound-name">
          <span>{{localize level.label}}</span>
          {{#if @root.unlocked}}
          <input type="number" name="system.woundSlots.{{level.id}}" value="{{lookup @root.system.woundSlots level.id}}" min="0" data-dtype="Number" />
          {{/if}}
        </label>
        <div class="wound-boxes">
          {{#each (range 1 wound.max) as |box|}}
            <a class="shield {{#if (gte wound.value box)}}filled{{/if}}" data-action="setWound" data-level="{{level.id}}" data-box="{{box}}"></a>
          {{/each}}
        </div>
        <span class="wound-malus">{{signed level.malus}}</span>
      </div>
      {{/with}}
    {{/each}}
    {{! Sur sa propre ligne, sous les blessures : à droite des cases, une fenêtre étroite le
        repoussait hors de vue. Sans malus ni état mourant, rien n'est affiché. }}
    {{#if (or wounds.malus system.isDying)}}
    <div class="malus-line">
      {{#if wounds.malus}}
        <span class="current-malus">{{localize "CDG.label.long.currentWoundMalus"}} <strong>{{signed wounds.malus}}</strong></span>
      {{/if}}
      {{#if system.isDying}}
        {{#if wounds.dying}}
        <a class="dying-toggle" data-action="toggleDying" data-tooltip="{{localize 'CDG.ui.toggleDying'}}">
          <i class="fas fa-skull"></i> {{localize "CDG.ui.dying"}}
        </a>
        {{else}}
        <a class="dying-toggle cleared" data-action="toggleDying" data-tooltip="{{localize 'CDG.ui.toggleStabilized'}}">
          <i class="fas fa-heart-pulse"></i> {{localize "CDG.ui.stabilized"}}
        </a>
        {{/if}}
      {{/if}}
    </div>
    {{/if}}
  </div>
</header>
