{{!
  Une ligne de roster : Nom / Grade / Notes en texte libre, ou liée à un acteur réel glissé depuis
  la barre latérale (portrait, lien vers sa fiche). `roster` vaut `pj` ou `pnj`, `entry` porte
  `index`, `actorUuid`, `name`, `grade`, `notes` et `actor` (résolu, ou `null`).
}}
<li class="item-row roster-row" data-roster="{{roster}}" data-roster-row data-index="{{entry.index}}">
  {{#if entry.actor}}
    <img class="item-img" src="{{entry.actor.img}}" data-action="openRosterActor" data-tooltip="{{localize 'CDG.origin.open'}}" />
  {{/if}}

  {{#if @root.unlocked}}
    <input type="text" class="roster-name" name="system.{{#if (eq roster 'pj')}}rosterPJ{{else}}rosterPNJ{{/if}}.{{entry.index}}.name"
      value="{{entry.name}}" placeholder="{{localize 'CDG.label.long.name'}}" spellcheck="false" />
    <input type="text" class="roster-grade" name="system.{{#if (eq roster 'pj')}}rosterPJ{{else}}rosterPNJ{{/if}}.{{entry.index}}.grade"
      value="{{entry.grade}}" placeholder="{{localize 'CDG.label.long.grade'}}" spellcheck="false" />
    <input type="text" class="roster-notes" name="system.{{#if (eq roster 'pj')}}rosterPJ{{else}}rosterPNJ{{/if}}.{{entry.index}}.notes"
      value="{{entry.notes}}" placeholder="{{localize 'CDG.label.long.notes'}}" spellcheck="false" />
  {{else}}
    <span class="roster-name">{{#if entry.actor}}{{entry.actor.name}}{{else}}{{entry.name}}{{/if}}</span>
    <span class="roster-grade">{{entry.grade}}</span>
    <span class="roster-notes">{{entry.notes}}</span>
  {{/if}}

  {{#if @root.unlocked}}
    {{#if entry.actor}}
      <a class="item-control" data-action="unlinkRosterActor" data-tooltip="{{localize 'CDG.company.unlinkActor'}}"><i class="fas fa-link-slash"></i></a>
    {{/if}}
    <a class="item-control" data-action="removeRosterEntry" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
  {{/if}}
</li>
