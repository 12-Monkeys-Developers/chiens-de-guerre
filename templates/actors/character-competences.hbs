<section class="tab tab-competences{{#if tabs.competences.active}} active{{/if}}" data-group="primary" data-tab="competences">
  <div class="flexrowsb">
    <div class="section-skills">
      <h2 class="section-title section-title-art" data-bandeau="comps">
        <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/comps.webp" alt="{{localize 'CDG.label.long.skills'}}" />
      </h2>
      <div class="skill-columns">
        {{#each skillColumns as |column|}}
          <ul class="skill-column">
            {{#each column as |skill|}}
              <li class="skill" data-skill="{{skill.id}}">
                <span class="skill-name draggable" data-action="rollTest" data-cdg-macro="test" data-tooltip="{{localize 'CDG.roll.title'}}">{{localize skill.label}}</span>
                {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
                    path=(concat "system.skills." skill.id ".rank")
                    rank=(lookup (lookup @root.skills skill.id) "rank")
                    editable=@root.unlocked}}
              </li>
            {{/each}}
          </ul>
        {{/each}}
      </div>
    </div>
    <div class="section-traits">
      <h2 class="section-title section-title-right section-title-art" data-bandeau="personnalite">
        <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/personnalite.webp" alt="{{localize 'CDG.label.long.traits'}}" />
      </h2>
      <div class="karma-block">
        <div class="totals">
          <span class="total vices">{{localize "CDG.label.long.vicesTotal"}} <strong>{{karma.vices}}</strong></span>
          <span class="total virtues">{{localize "CDG.label.long.virtuesTotal"}} <strong>{{karma.virtues}}</strong></span>
        </div>
        <div class="karma">
          <label>{{localize "CDG.label.long.karma"}}</label>
          <strong>{{signed karma.value}}</strong>
        </div>
        <div class="allegiance allegiance-{{karma.allegiance}}" data-tooltip="{{localize "CDG.label.long.allegiance"}} : {{localize karma.allegianceLabel}}">
          <i class="{{allegeanceIcon karma.allegiance}}"></i>
        </div>
        <div class="tokens">
        <a class="clear-token" data-action="clearInvokedTraits" data-tooltip="{{localize "CDG.ui.clearInvokedTraits"}}"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
      </div>
      <ul class="trait-pairs">
        {{#each traitPairs as |pair|}}
          <li class="trait-pair {{#if pair.invoked}}invoked{{/if}}" data-pair="{{pair.id}}">
            <span class="trait-label vice {{#if pair.isVice}}dominant{{/if}}">{{localize pair.vice}}</span>

            {{! Colonne des vices : les cases sont rendues de 1 à 3 comme celles des vertus, et la
                feuille de style les retourne (row-reverse) pour que la case 1 soit la plus proche du
                libellé, comme sur la fiche papier. }}
            <div class="trait-boxes vice">
              {{#each (range 1 3) as |step|}}
                <a class="shield {{#if (and pair.isVice (gte pair.value step))}}filled{{/if}}"
                  {{#if @root.unlocked}}data-action="setTrait" data-pair="{{pair.id}}" data-side="vice" data-value="{{step}}"{{/if}}></a>
              {{/each}}
            </div>

            <div class="trait-boxes virtue">
              {{#each (range 1 3) as |step|}}
                <a class="shield {{#if (and pair.isVirtue (gte pair.value step))}}filled{{/if}}"
                  {{#if @root.unlocked}}data-action="setTrait" data-pair="{{pair.id}}" data-side="virtue" data-value="{{step}}"{{/if}}></a>
              {{/each}}
            </div>

            <span class="trait-label virtue {{#if pair.isVirtue}}dominant{{/if}}">{{localize pair.virtue}}</span>

            <a class="invoke" data-action="invokeTrait" data-pair="{{pair.id}}"
              data-tooltip="{{localize 'CDG.ui.invokeTraitHint'}}">
              <i class="fas {{#if pair.invoked}}fa-fire{{else}}fa-fire-flame-simple{{/if}}"></i>
            </a>
          </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
