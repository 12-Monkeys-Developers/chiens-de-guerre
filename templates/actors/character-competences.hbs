<section class="tab tab-competences{{#if tabs.competences.active}} active{{/if}}" data-group="primary" data-tab="competences">
  <div class="flexrowsb">
    <div class="section-skills" style="width:fit-content;">
      <h2 class="section-title">{{localize "CDG.label.long.skills"}}</h2>
      <div class="skill-columns">
        {{#each skillColumns as |column|}}
          <ul class="skill-column">
            {{#each column as |skill|}}
              <li class="skill" data-skill="{{skill.id}}">
                <span class="skill-name">{{localize skill.label}}</span>
                {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
                    path=(concat "system.skills." skill.id ".rank")
                    rank=(lookup (lookup @root.skills skill.id) "rank")
                    editable=@root.isEditable}}
              </li>
            {{/each}}
          </ul>
        {{/each}}
      </div>
    </div>
    <div clas="section-traits" style="width:fit-content;">
    <h2 class="section-title section-title-right">{{localize "CDG.label.long.traits"}}</h2>

      <ul class="trait-pairs">
        {{#each traitPairs as |pair|}}
          <li class="trait-pair {{#if pair.invoked}}invoked{{/if}}" data-pair="{{pair.id}}">
            <span class="trait-label vice {{#if pair.isVice}}dominant{{/if}}">{{localize pair.vice}}</span>

            {{! Colonne des vices : les cases sont rendues de 1 à 3 comme celles des vertus, et la
                feuille de style les retourne (row-reverse) pour que la case 1 soit la plus proche du
                libellé, comme sur la fiche papier. }}
            <div class="trait-boxes vice">
              {{#each (range 1 3) as |step|}}
                {{#if unlocked}}
                  <a class="box {{#if (and pair.isVice (gte pair.value step))}}filled{{/if}}"
                    data-action="setTrait" data-pair="{{pair.id}}" data-side="vice" data-value="{{step}}"></a>
                    {{else}}
                  <a class="box {{#if (and pair.isVice (gte pair.value step))}}filled{{/if}}"></a>
                {{/if}}
              {{/each}}
            </div>

            <div class="trait-boxes virtue">
              {{#each (range 1 3) as |step|}}
                <a class="box {{#if (and pair.isVirtue (gte pair.value step))}}filled{{/if}}"
                  data-action="setTrait" data-pair="{{pair.id}}" data-side="virtue" data-value="{{step}}"></a>
              {{/each}}
            </div>

            <span class="trait-label virtue {{#if pair.isVirtue}}dominant{{/if}}">{{localize pair.virtue}}</span>

            <a class="invoke" data-action="invokeTrait" data-pair="{{pair.id}}"
              data-tooltip="{{localize 'CDG.ui.invokeTraitHint'}}">
              <i class="fas {{#if pair.invoked}}fa-fire{{else}}fa-fire-flame-simple{{/if}}"></i>
            </a>
          </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
