<section class="tab tab-biographie{{#if tabs.biographie.active}} active{{/if}}" data-group="primary" data-tab="biographie">

  {{! Expérience et Langues côte à côte ; la biographie garde toute la largeur en dessous. }}
  <div class="biographie-top">
    <div class="field-line">
      <label>{{localize "CDG.label.long.vraiNom"}}</label>
      {{#if unlocked}}
        <input type="text" name="system.identity.vraiNom" value="{{identity.vraiNom}}" spellcheck="false" />
      {{else}}
        <span class="value">{{identity.vraiNom}}</span>
      {{/if}}
    </div>

    {{! Origine : l'objet fait foi dès qu'il est là ; le champ texte n'est plus qu'un repli, et
        il réapparaît intact si l'on retire l'objet. }}
    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.peuple"}}</label>
      {{#if peuple}}
        <span class="value origin" data-item-id="{{peuple.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{peuple.name}}</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeOrigin" data-item-id="{{peuple.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Peuple"</span>
      {{/if}}
    </div>
    {{! Origine : l'objet fait foi dès qu'il est là ; le champ texte n'est plus qu'un repli, et
        il réapparaît intact si l'on retire l'objet. }}
    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.carriere"}}</label>
      {{#if carriere}}
        <span class="value origin" data-item-id="{{carriere.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{carriere.name}}</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeOrigin" data-item-id="{{carriere.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Carrière"</span>
      {{/if}}
    </div>

    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.ascendance"}}</label>
      {{#if ascendance}}
        <span class="value origin" data-item-id="{{ascendance.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{ascendance.name}} ({{ascendance.system.compulsion}})</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeAscendance" data-item-id="{{ascendance.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Ascendance"</span>
      {{/if}}
    </div>
    <div class="field-line">
      <label>{{localize "CDG.label.long.grade"}}</label>
      {{#if unlocked}}
        <select name="system.identity.grade">
          {{selectOptions choiceGrades selected=identity.grade blank="" localize=true labelAttr="label" valueAttr="id"}}
        </select>
      {{else}}
        <span class="value">{{#if identity.grade}}{{localize (concat "CDG.grades." identity.grade)}}{{/if}}</span>
      {{/if}}
    </div>
    <div class="field-line">
      <label>{{localize "CDG.label.long.religion"}}</label>
      {{#if unlocked}}
        <input type="text" name="system.identity.religion" value="{{identity.religion}}" spellcheck="false" />
      {{else}}
        <span class="value">{{identity.religion}}</span>
      {{/if}}
    </div>
    <section class="experience">
    <h2 class="section-title section-title-art" data-bandeau="xp">
        <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/xp.webp" alt="{{localize 'CDG.label.long.xp'}}" />
      </h2>
      <div class="xp-line">
        <label>{{localize "CDG.label.long.xpTotal"}}</label>
        <input type="number" name="system.xp.total" value="{{xp.total}}" min="0" data-dtype="Number" />
      </div>
      <div class="xp-line">
        <label>{{localize "CDG.label.long.xpSpent"}}</label>
        <input type="number" name="system.xp.spent" value="{{xp.spent}}" min="0" data-dtype="Number" />
      </div>
      {{!-- Le disponible se déduit des deux lignes du dessus : il occupe le même créneau qu'un
            champ de saisie, mais en rouge et sans filet — il ne se modifie pas. --}}
      <div class="xp-line total">
        <label>{{localize "CDG.label.long.xpAvailable"}}</label>
        <strong>{{xp.available}}</strong>
      </div>
    </section>

    <section class="languages">
      {{!-- La règle de l'écrit se lit au survol du titre : sous les langues, elle occupait la place
            d'une section pour une précision qu'on ne consulte qu'une fois. L'info-bulle est portée
            par le titre et non par la lame, que `.title-art` met hors de portée de la souris. --}}
      <h2 class="section-title section-title-right section-title-art" data-bandeau="langues"
        data-tooltip="{{localize 'CDG.ui.languagesHint'}}" data-tooltip-direction="UP">
        <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/langues.webp" alt="{{localize 'CDG.label.long.languages'}}" />
      </h2>
      <ul class="language-list">
        {{#each languages as |language|}}
          <li class="language">
            <a class="shield {{#if language.known}}filled{{/if}}" data-action="toggleLanguage" data-language="{{language.id}}"></a>
            <span>{{localize language.label}}</span>
          </li>
        {{/each}}
      </ul>
    </section>
  </div>

  <section class="biography-section">
    <h2 class="section-title section-title-art" data-bandeau="biography">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/biographie.webp" alt="{{localize 'CDG.label.long.biography'}}" />
    </h2>
    <div class="free-text">
      {{formInput systemFields.details.fields.biography value=system.details.biography
        enriched=enrichedBiography name="system.details.biography" toggled=true}}
    </div>
  </section>

</section>
