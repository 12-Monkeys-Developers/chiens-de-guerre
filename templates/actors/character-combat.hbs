<section class="tab tab-combat{{#if tabs.combat.active}} active{{/if}}" data-group="primary" data-tab="combat">

  <div class="combat-deuxcol">
    <div class="combat-actions">
      <h2 class="section-title section-title-art" data-bandeau="actionscombat">
        <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/actionscombat.webp" alt="{{localize 'CDG.label.long.actionscombat'}}" />
      </h2>
      <div class="actionscombat-block">
        <div class="combat-quick-actions">
          <button class="draggable" type="button" data-action="rollInitiative" data-cdg-macro="initiative" data-tooltip="{{localize 'CDG.combat.initiative.roll'}}">
            <i class="fa-solid fa-stopwatch"></i> {{localize "CDG.combat.initiative.title"}}</button>
        </div>
        <div class="initiative-line">
          <div class="init-modifier">
            <label data-tooltip="{{localize 'CDG.label.long.initiativeModifier'}}">{{localize "CDG.label.long.modifier"}} :</label>
            <span class="value" data-tooltip-html="{{initiativeModifierTooltip}}">{{signed combat.initiative.modifier}}</span>
          </div>
          <div class="init-bonus">
            <label>{{localize "CDG.label.long.initiativeBonus"}} :</label>
            <input type="number" name="system.combat.initiative.bonus" value="{{combat.initiative.bonus}}" data-dtype="Number" />
          </div>
          {{#if canDualWield}}
            <div class="init-dual-wield">
              <label>{{localize "CDG.combat.initiative.dualWield"}} :</label>
              <span class="value">{{signed dualWieldInitiativeBonus}}</span>
            </div>
          {{/if}}
          {{#if combat.armorOverloaded}}
            <p class="warning">{{localize "CDG.ui.armorOverloaded"}}</p>
          {{/if}}
        </div>
        <div class="combat-quick-actions">
          <button class="draggable" type="button" data-action="rollDefense" data-cdg-macro="defense" data-defense="dodge"><i class="fa-solid fa-person-running"></i> {{localize "CDG.combat.defense.dodge"}}</button>
        </div>
        <div class="dodge-track" data-tooltip="{{localize "CDG.label.long.nextDodge"}}">
          <label>{{localize "CDG.label.long.malus"}}</label>
          {{#each SYSTEM.DODGE_MALUS as |malus index|}}
            <a class="dodge-step {{#if (gte @root.combat.dodgesUsed index)}}used{{/if}}"
              data-action="setDodges" data-count="{{index}}">{{signed malus}}</a>
          {{/each}}
        </div>
        <div class="combat-quick-actions">
          <button class="draggable" type="button" data-action="rollDefense" data-cdg-macro="defense" data-defense="parry"><i class="fa-solid fa-shield"></i> {{localize "CDG.combat.defense.parry"}}</button>
        </div>
        <div class="parry">
          <a class="parry-toggle {{#unless combat.canParry}}used{{/unless}}" data-action="toggleParry"
            data-tooltip="{{localize 'CDG.ui.parryHint'}}">
            <i class="fas {{#if combat.canParry}}fa-shield{{else}}fa-shield-slash{{/if}}"></i>
            {{#if combat.canParry}}{{localize "CDG.ui.parryAvailable"}}{{else}}{{localize "CDG.ui.parryUsed"}}{{/if}}
          </a>
        </div>
      </div>
    </div>
      <div class="wounds-block">
        <h2 class="section-title section-title-right section-title-art" data-bandeau="blessures">
          <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/blessures.webp" alt="{{localize 'CDG.label.long.wounds'}}" />
        </h2>
        <ul class="wound-levels">
          {{#each woundLevels as |level|}}
            {{#with (lookup @root.wounds level.id) as |wound|}}
              <li class="wound-level" data-level="{{level.id}}">
                <span class="wound-name">{{localize level.label}}</span>
                <div class="wound-boxes">
                  {{#each (range 1 wound.max) as |box|}}
                    <a class="shield {{#if (gte wound.value box)}}filled{{/if}}"
                      data-action="setWound" data-level="{{level.id}}" data-box="{{box}}"></a>
                  {{/each}}
                </div>
                <span class="wound-malus">{{signed level.malus}}</span>
              </li>
            {{/with}}
          {{/each}}
        </ul>
      </div>
        {{! Armes et protections tiennent en une seule liste, comme sur la fiche imprimée : les
      protections d'abord — armures puis boucliers —, les armes ensuite. Le bandeau
      calligraphié porte déjà les deux mots. }}
      <div class="combat-gear">
        <section class="gear-combat">
          <h2 class="section-title section-title-art" data-bandeau="armes">
            <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/armes.webp" alt="{{localize 'CDG.label.long.weaponsAndProtections'}}" />
            <span class="title-actions">
              <a class="item-control draggable" data-action="rollSoak" data-cdg-macro="soak" data-tooltip="{{localize 'CDG.combat.soakTest'}}"><i class="fa-solid fa-helmet-battle"></i></a>
              {{#if isEditable}}
                {{! Trois icônes distinctes : réunis sous un seul titre, trois `fa-plus` identiques
                    ne se distingueraient plus que par leur infobulle. }}
                <a class="create" data-action="createItem" data-type="equipment" data-subtype="armor"
                  data-tooltip="{{localize 'CDG.ui.addArmor'}}"><i class="fas fa-shirt-long-sleeve"></i></a>
                <a class="create" data-action="createItem" data-type="equipment" data-subtype="shield"
                  data-tooltip="{{localize 'CDG.ui.addShield'}}"><i class="fas fa-shield-halved"></i></a>
                <a class="create" data-action="createItem" data-type="equipment" data-subtype="weapon"
                  data-tooltip="{{localize 'CDG.ui.addWeapon'}}"><i class="fas fa-sword"></i></a>
              {{/if}}
            </span>
          </h2>
          <ul class="item-list">
            {{#each armors as |armor|}}
              <li class="item-row draggable {{#if armor.system.equipped}}equipped{{/if}}" data-item-id="{{armor.id}}">
                <a class="equip-toggle" data-action="toggleEquipped" data-tooltip="{{localize 'CDG.ui.toggleEquipped'}}">
                  <i class="fas {{#if armor.system.equipped}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
                </a>
                <img class="item-img" src="{{armor.img}}" data-action="editItem" />
                <span class="item-name">{{armor.name}}</span>
                <span class="item-label">{{localize "CDG.label.long.protection"}}</span>
                {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
                    rank=armor.system.protection.rank editable=false}}
                <span class="item-init">{{localize "CDG.label.short.init"}} {{signed armor.system.initMalus}}</span>
                {{#if @root.unlocked}}
                  <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </li>
            {{/each}}

            {{#each shields as |shield|}}
              <li class="item-row draggable {{#if shield.system.equipped}}equipped{{/if}}" data-item-id="{{shield.id}}">
                <a class="equip-toggle" data-action="toggleEquipped" data-tooltip="{{localize 'CDG.ui.toggleEquipped'}}">
                  <i class="fas {{#if shield.system.equipped}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
                </a>
                <img class="item-img" src="{{shield.img}}" data-action="editItem" />
                <span class="item-name">{{shield.name}}</span>
                <span class="item-label">{{localize "CDG.label.long.blockBonus"}}</span>
                <span class="item-value">{{signed shield.system.blockBonus}}</span>
                <span class="item-init">{{localize "CDG.label.short.init"}} {{signed shield.system.initMalus}}</span>
                {{#if @root.unlocked}}
                  <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </li>
            {{/each}}

            {{#each weapons as |weapon|}}
              <li class="item-row draggable {{#if weapon.system.equipped}}equipped{{/if}}" data-item-id="{{weapon.id}}">
                <a class="equip-toggle" data-action="toggleEquipped" data-tooltip="{{localize 'CDG.combat.weapon.toggleHeld'}}"><i class="fas {{#if weapon.system.equipped}}fa-hand-fist{{else}}fa-hand{{/if}}"></i></a>
                <img class="item-img" src="{{weapon.img}}" data-action="editItem" />
                <span class="item-name">{{weapon.name}}</span>
                {{#if weapon.system.equipped}}
                  <a class="item-control weapon-attack" data-action="rollWeapon" data-tooltip="{{localize 'CDG.ui.attackWithWeapon'}}">
                    <i class="fas {{#if weapon.system.isRangedWeapon}}fa-bow-arrow{{else}}fa-sword{{/if}}"></i>
                  </a>
                  <a class="item-control" data-action="rollDamage" data-tooltip="{{localize 'CDG.combat.damageTest'}}"><i class="fa-solid fa-burst"></i></a>
                {{/if}}
                <span class="item-label">{{localize "CDG.label.long.damage"}}</span>
                {{> "systems/chiens-de-guerre/templates/shared/rank-shields.hbs"
                    rank=weapon.system.damage.rank editable=false}}
                {{#if @root.unlocked}}
                  <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </section>
      </div>
  </div>

  {{! Le repos de fin de journée rend leurs points aux réserves que le combat a vidées : il clôt
      l'onglet, après les blessures et les armes. }}
  <section class="rest">
    <h2 class="section-title section-title-art" data-bandeau="repos">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/repos.webp" alt="{{localize 'CDG.label.long.rest'}}" />
    </h2>
    <div class="rest-buttons">
      {{#each choiceRestConditions as |condition|}}
        <a class="rest-button" data-action="rest" data-condition="{{condition.id}}"
          data-tooltip="{{localize 'CDG.ui.restHint'}}">
          {{localize condition.label}} <span class="recovery">+{{condition.recovery}}</span>
        </a>
      {{/each}}
    </div>
  </section>
</section>
