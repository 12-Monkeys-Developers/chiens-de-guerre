<section class="tab tab-arcanums{{#if tabs.arcanums.active}} active{{/if}}" data-group="primary" data-tab="arcanums">

  <section class="arcanums">
    <h2 class="section-title">
      {{localize "CDG.label.long.arcanums"}}
      {{#if isEditable}}
        <a class="create" data-action="createItem" data-type="arcanum" data-tooltip="{{localize 'CDG.ui.addArcanum'}}"><i class="fas fa-plus"></i></a>
      {{/if}}
    </h2>
    <ul class="item-list arcanum-list">
      {{#each arcanums as |arcanum|}}
        <li class="item-row draggable" data-item-id="{{arcanum.id}}">
          <img class="item-img" src="{{arcanum.img}}" data-action="editItem" />
          <span class="item-name" data-action="editItem">{{arcanum.name}}</span>
          <span class="arcanum-type">{{localize (concat "CDG.arcanum.types." arcanum.system.arcanumType)}}</span>
          <span class="arcanum-rank" data-tooltip="{{localize 'CDG.label.long.rank'}}">{{arcanum.system.rank}}</span>
          {{#if arcanum.system.isPassive}}
            <span class="arcanum-bonus">{{signed arcanum.system.bonus}}</span>
          {{else}}
            <span class="arcanum-cost">{{arcanum.system.espritCost}} {{localize "CDG.abilities.short.esprit"}}</span>
          {{/if}}
          {{#if @root.isEditable}}
            <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
          {{/if}}
        </li>
      {{else}}
        <li class="empty">{{localize "CDG.ui.noArcanum"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="special-traits">
    <h2 class="section-title">
      {{localize "CDG.label.long.specialTraits"}}
      {{#if isEditable}}
        <a class="create" data-action="createItem" data-type="feature" data-tooltip="{{localize 'CDG.ui.addFeature'}}"><i class="fas fa-plus"></i></a>
      {{/if}}
    </h2>
    {{#each featureGroups as |group|}}
      <h3 class="group-title">{{localize group.label}}</h3>
      <ul class="item-list">
        {{#each group.features as |feature|}}
          <li class="item-row draggable" data-item-id="{{feature.id}}">
            <img class="item-img" src="{{feature.img}}" data-action="editItem" />
            <span class="item-name" data-action="editItem">{{feature.name}}</span>
            {{#if feature.system.hasSuspicion}}
              <span class="suspicion suspicion-{{feature.system.suspicion}}">
                {{localize (concat "CDG.feature.suspicions." feature.system.suspicion)}}
              </span>
            {{/if}}
            {{#if @root.isEditable}}
              <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{/each}}
    <div class="free-text">
      {{formInput systemFields.specialTraits value=system.specialTraits enriched=enrichedSpecialTraits name="system.specialTraits" toggled=true}}
    </div>
  </section>

  {{!-- Pense-bête : ces bonus ne sont jamais appliqués d'office, puisque le système ne sait pas
        ce que le personnage cherche à obtenir. Le dialogue de jet les proposera. --}}
  <section class="situational-modifiers">
    <h2 class="section-title">{{localize "CDG.label.long.situationalModifiers"}}</h2>
    <ul class="modifier-list">
      {{#each situationalModifiers as |modifier|}}
        <li class="modifier">
          <span class="modifier-value">{{signed modifier.value}}</span>
          <span class="modifier-label">{{modifier.label}}</span>
          <span class="modifier-situation">{{localize modifier.situationLabel}}</span>
        </li>
      {{else}}
        <li class="empty">{{localize "CDG.ui.noSituationalModifier"}}</li>
      {{/each}}
    </ul>
    {{#if situationalModifiers.length}}
      <p class="hint">{{localize "CDG.ui.situationalHint"}}</p>
    {{/if}}
  </section>

  <div class="arcanums-side">
    <section class="languages">
      <h2 class="section-title section-title-right">{{localize "CDG.label.long.languages"}}</h2>
      <ul class="language-list">
        {{#each languages as |language|}}
          <li class="language">
            <a class="box {{#if language.known}}checked{{/if}}" data-action="toggleLanguage" data-language="{{language.id}}"></a>
            <span>{{localize language.label}}</span>
          </li>
        {{/each}}
      </ul>
      <p class="hint">{{localize "CDG.ui.languagesHint"}}</p>
    </section>

    <section class="experience">
      <h2 class="section-title section-title-right">{{localize "CDG.label.long.xp"}}</h2>
      <div class="xp-line">
        <label>{{localize "CDG.label.long.xpTotal"}}</label>
        <input type="number" name="system.xp.total" value="{{xp.total}}" min="0" data-dtype="Number" />
      </div>
      <div class="xp-line">
        <label>{{localize "CDG.label.long.xpSpent"}}</label>
        <input type="number" name="system.xp.spent" value="{{xp.spent}}" min="0" data-dtype="Number" />
      </div>
      <div class="xp-line total">
        <label>{{localize "CDG.label.long.xpAvailable"}}</label>
        <strong>{{xp.available}}</strong>
      </div>
    </section>
  </div>

</section>
