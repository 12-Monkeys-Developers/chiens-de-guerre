<section class="tab tab-equipement{{#if tabs.equipement.active}} active{{/if}}" data-group="primary" data-tab="equipement">

  <section class="gear">
    <h2 class="section-title section-title-art" data-bandeau="equipement">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/equipement.webp" alt="{{localize 'CDG.label.long.equipment'}}" />
      {{#if isEditable}}
        <span class="title-actions">
          <a class="create" data-action="createItem" data-type="equipment" data-subtype="misc"
            data-tooltip="{{localize 'CDG.ui.addGear'}}"><i class="fas fa-plus"></i></a>
        </span>
      {{/if}}
    </h2>
    <ul class="item-list gear-list">
      {{#each gear as |item|}}
        {{!-- La description se lit au survol de la ligne : elle est trop longue pour la colonne,
              et ouvrir la fiche pour deux phrases est un détour. --}}
        <li class="item-row draggable" data-item-id="{{item.id}}"
          {{#if item.system.hasDescription}}data-tooltip-html="{{item.system.description}}" data-tooltip-direction="UP"{{/if}}>
          <img class="item-img" src="{{item.img}}" data-action="editItem" />
          <span class="item-name" data-action="editItem">{{item.name}}</span>
          <span class="item-quantity">×{{item.system.quantity}}</span>
          {{#if @root.unlocked}}
            <a class="item-control" data-action="deleteItem" data-tooltip="{{localize 'CDG.ui.delete'}}"><i class="fas fa-trash"></i></a>
          {{/if}}
        </li>
      {{else}}
        <li class="empty full-width">{{localize "CDG.ui.noGear"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="purse">
    <h2 class="section-title section-title-art" data-bandeau="bourse">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/bourse.webp" alt="{{localize 'CDG.label.long.purse'}}" />
    </h2>
    <ul class="currency-list">
      {{#each currencies as |currency|}}
        <li class="currency">
          {{!-- La conversion ne concerne que le ducat : elle se lit au survol de son libellé. --}}
          <label {{#if (eq currency.id "ducat")}}data-tooltip="{{localize 'CDG.ui.currencyHint'}}"{{/if}}>{{localize currency.label}}</label>
          <input type="number" name="system.wealth.{{currency.id}}" value="{{lookup @root.wealth currency.id}}" min="0" data-dtype="Number" />
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="rest">
    <h2 class="section-title">{{localize "CDG.label.long.rest"}}</h2>
    <div class="rest-buttons">
      {{#each choiceRestConditions as |condition|}}
        <a class="rest-button" data-action="rest" data-condition="{{condition.id}}"
          data-tooltip="{{localize 'CDG.ui.restHint'}}">
          {{localize condition.label}} <span class="recovery">+{{condition.recovery}}</span>
        </a>
      {{/each}}
    </div>
  </section>

</section>
