<section class="tab tab-description{{#if tabs.description.active}} active{{/if}}" data-group="primary" data-tab="description">

  <section class="notes-section">
    <h2 class="section-title">{{localize "CDG.label.long.description"}}</h2>
    <div class="free-text">
      {{formInput systemFields.details.fields.description value=system.details.description
        enriched=enrichedDescription name="system.details.description" toggled=true}}
    </div>
  </section>

  {{#if isEditable}}
    <section class="notes-section">
      <h2 class="section-title">{{localize "CDG.label.long.notesPrivate"}}</h2>
      <div class="free-text">
        {{formInput systemFields.details.fields.notes value=system.details.notes
          enriched=enrichedNotes name="system.details.notes" toggled=true}}
      </div>
    </section>
  {{/if}}

</section>
