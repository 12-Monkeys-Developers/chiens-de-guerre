<section class="tab tab-chroniques{{#if tabs.chroniques.active}} active{{/if}}" data-group="primary" data-tab="chroniques">
  <section class="chronicles">
      <h2 class="section-title section-title-left section-title-art" data-bandeau="chroniques">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/chroniques.webp" alt="{{localize 'CDG.label.long.chronicles'}}" />
      {{#if unlocked}}<a data-action="addChronicle" data-tooltip="{{localize 'CDG.ui.add'}}"><i class="fas fa-plus"></i></a>{{/if}}
    </h2>
    <ul class="item-list">
      {{#each chronicles as |chronicle|}}
        {{> "systems/chiens-de-guerre/templates/actors/partials/compagnie-chronicle-row.hbs" entry=chronicle}}
      {{else}}
        <li class="empty">{{localize "CDG.company.noChronicles"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="notes-section">
      <h2 class="section-title section-title-left section-title-art" data-bandeau="notes">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/notes.webp" alt="{{localize 'CDG.label.long.notes'}}" />
      </h2>
    <div class="free-text">
      {{formInput systemFields.notes value=system.notes enriched=enrichedNotes name="system.notes" toggled=true}}
    </div>
  </section>
</section>
