<header class="sheet-header">

  <div class="left-col">
    <div class="name-line">
      {{#if unlocked}}
        <input type="text" name="name" value="{{actor.name}}" spellcheck="false" />
      {{else}}
        <span class="value name">{{actor.name}}</span>
      {{/if}}
    </div>
    <div class="banner">
      <div class="portrait">
        <img class="actor-img" src="{{actor.img}}" data-tooltip="{{actor.name}}"
          {{#if unlocked}}data-action="editImage" data-edit="img"{{/if}} />
      </div>
    </div>
  </div>
  <div class="passion">
      <div class="passion-block">
      <img class="passion-art" src="systems/chiens-de-guerre/ui/fiche/titres/passion.webp" alt="{{localize 'CDG.label.long.purse'}}" data-tooltip="{{localize 'CDG.ui.passionHint'}}" data-tooltip-direction="UP">
        <div class="tokens">
          <a data-action="adjustPassion" data-delta="-1" data-tooltip="{{localize 'CDG.ui.spendPassion'}}"><i class="fas fa-minus"></i></a>
          <span class="token-count">{{passion.tokens}}</span>
          <a data-action="adjustPassion" data-delta="1" data-tooltip="{{localize 'CDG.ui.gainPassion'}}"><i class="fas fa-plus"></i></a>
        </div>
        <div class="tokens">
        <a class="clear-token" data-action="clearInvokedTraits" data-tooltip="{{localize "CDG.ui.clearInvokedTraits"}}"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
      </div>

  </div>

  <section class="abilities">
    <h2 class="section-title section-title-right section-title-art" data-bandeau="caracs">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/caracs.webp" alt="{{localize 'CDG.label.long.abilities'}}" />
    </h2>
    <ol class="ability-list">
      {{#each SYSTEM.ABILITIES as |ability id|}}
        {{#with (lookup @root.abilities id) as |pool|}}
          <li class="ability" data-ability="{{id}}">
            <span class="ability-name draggable" data-action="rollTest" data-cdg-macro="test" data-tooltip="{{localize 'CDG.roll.title'}}">{{localize ability.label}}</span>

            <div class="pool">
              <a class="pool-step" data-action="adjustPool" data-ability="{{id}}" data-delta="-1"><i class="fas fa-minus"></i></a>
              <span class="pool-value" data-tooltip="{{localize 'CDG.ui.poolHint'}}">{{pool.value}}</span>
              <span class="pool-separator">/</span>
              {{!-- La fiche n'édite jamais que la base : le bonus d'effet (peuple, carrière…)
                    s'ajoute à part, jamais écrit en dur dans le champ — seule l'infobulle du
                    maximum en dit la source, sans marque visuelle à part. --}}
              {{#if @root.unlocked}}
                <input class="pool-max" type="number" name="system.abilities.{{id}}.max" value="{{pool.baseMax}}" min="0" data-dtype="Number"
                  {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips id}}"{{/if}} />
              {{else}}
                <span class="pool-max" {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips id}}"{{/if}}>{{pool.max}}</span>
              {{/if}}
              <a class="pool-step" data-action="adjustPool" data-ability="{{id}}" data-delta="1"><i class="fas fa-plus"></i></a>
            </div>

            <div class="improvements" data-tooltip="{{localize 'CDG.ui.improvementsHint'}}">
              {{#each (range 1 @root.SYSTEM.ABILITY_MAX_IMPROVEMENTS) as |step|}}
                <span class="bubble {{#if (gte pool.improvements step)}}filled{{/if}}"></span>
              {{/each}}
            </div>
          </li>
        {{/with}}
      {{/each}}
    </ol>

    <div class="field-line malus-line">
      {{#if wounds.malus}}
        <p class="current-malus">
          {{localize "CDG.label.long.currentWoundMalus"}}
        </p>
        <p class="current-malus"><strong>{{signed wounds.malus}}</strong>
        </p>
      {{/if}}
      {{#if system.isDying}}
        {{#if wounds.dying}}
        <a class="dying-toggle" data-action="toggleDying" data-tooltip="{{localize 'CDG.ui.toggleDying'}}">
          <i class="fas fa-skull"></i> {{localize "CDG.ui.dying"}}
        </a>
        {{else}}
        <a class="dying-toggle cleared" data-action="toggleDying" data-tooltip="{{localize 'CDG.ui.toggleStabilized'}}">
          <i class="fas fa-heart-pulse"></i> {{localize "CDG.ui.stabilized"}}
        </a>
        {{/if}}
      {{/if}}
    </div>
  </section>
</header>
