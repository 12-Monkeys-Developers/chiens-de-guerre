<header class="sheet-header">

  <div class="banner">
    <div class="portrait">
      <img class="actor-img" src="{{actor.img}}" data-tooltip="{{actor.name}}"
        {{#if unlocked}}data-action="editImage" data-edit="img"{{/if}} />
    </div>
  </div>

  <div class="identity">
    <div class="field-line name-line">
      <label>{{localize "CDG.label.long.surnom"}}</label>
      {{#if unlocked}}
        <input type="text" name="name" value="{{actor.name}}" spellcheck="false" />
      {{else}}
        <span class="value name">{{actor.name}}</span>
      {{/if}}
    </div>

    <div class="field-line">
      <label>{{localize "CDG.label.long.vraiNom"}}</label>
      {{#if unlocked}}
        <input type="text" name="system.identity.vraiNom" value="{{identity.vraiNom}}" spellcheck="false" />
      {{else}}
        <span class="value">{{identity.vraiNom}}</span>
      {{/if}}
    </div>

    {{! Origine : l'objet fait foi dès qu'il est là ; le champ texte n'est plus qu'un repli, et
        il réapparaît intact si l'on retire l'objet. }}
    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.peuple"}}</label>
      {{#if peuple}}
        <span class="value origin" data-item-id="{{peuple.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{peuple.name}}</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeOrigin" data-item-id="{{peuple.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Peuple"</span>
      {{/if}}
    </div>
    {{! Origine : l'objet fait foi dès qu'il est là ; le champ texte n'est plus qu'un repli, et
        il réapparaît intact si l'on retire l'objet. }}
    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.carriere"}}</label>
      {{#if carriere}}
        <span class="value origin" data-item-id="{{carriere.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{carriere.name}}</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeOrigin" data-item-id="{{carriere.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Carrière"</span>
      {{/if}}
    </div>

    <div class="field-line origin-line">
      <label>{{localize "CDG.label.long.ascendance"}}</label>
      {{#if ascendance}}
        <span class="value origin" data-item-id="{{ascendance.id}}">
          <a data-action="editItem" data-tooltip="{{localize 'CDG.origin.open'}}">{{ascendance.name}} ({{ascendance.system.compulsion}})</a>
        </span>
        {{#if unlocked}}
          <a class="origin-remove" data-action="removeAscendance" data-item-id="{{ascendance.id}}" data-tooltip="{{localize 'CDG.origin.remove'}}">
            <i class="fas fa-xmark" inert></i>
          </a>
        {{/if}}
      {{else}}
        <span class="value">Déposez un Objet "Ascendance"</span>
      {{/if}}
    </div>
    <div class="field-line">
      <label>{{localize "CDG.label.long.grade"}}</label>
      {{#if unlocked}}
        <select name="system.identity.grade">
          {{selectOptions choiceGrades selected=identity.grade blank="" localize=true labelAttr="label" valueAttr="id"}}
        </select>
      {{else}}
        <span class="value">{{#if identity.grade}}{{localize (concat "CDG.grades." identity.grade)}}{{/if}}</span>
      {{/if}}
    </div>
    <div class="field-line">
      <label>{{localize "CDG.label.long.religion"}}</label>
      {{#if unlocked}}
        <input type="text" name="system.identity.religion" value="{{identity.religion}}" spellcheck="false" />
      {{else}}
        <span class="value">{{identity.religion}}</span>
      {{/if}}
    </div>
  </div>

  <section class="abilities">
    <h2 class="section-title section-title-right section-title-art" data-bandeau="caracs">
      <img class="title-art" src="systems/chiens-de-guerre/ui/fiche/titres/caracs.webp" alt="{{localize 'CDG.label.long.abilities'}}" />
    </h2>
    <ol class="ability-list">
      {{#each SYSTEM.ABILITIES as |ability id|}}
        {{#with (lookup @root.abilities id) as |pool|}}
          <li class="ability" data-ability="{{id}}">
            <span class="ability-name draggable" data-action="rollTest" data-cdg-macro="test" data-tooltip="{{localize 'CDG.roll.title'}}">{{localize ability.label}}</span>

            <div class="pool">
              <a class="pool-step" data-action="adjustPool" data-ability="{{id}}" data-delta="-1"><i class="fas fa-minus"></i></a>
              <span class="pool-value" data-tooltip="{{localize 'CDG.ui.poolHint'}}">{{pool.value}}</span>
              <span class="pool-separator">/</span>
              {{!-- La fiche n'édite jamais que la base : le bonus d'effet (peuple, carrière…)
                    s'ajoute à part, jamais écrit en dur dans le champ — seule l'infobulle du
                    maximum en dit la source, sans marque visuelle à part. --}}
              {{#if @root.unlocked}}
                <input class="pool-max" type="number" name="system.abilities.{{id}}.max" value="{{pool.baseMax}}" min="0" data-dtype="Number"
                  {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips id}}"{{/if}} />
              {{else}}
                <span class="pool-max" {{#if pool.bonus}}data-tooltip-html="{{lookup @root.abilityMaxTooltips id}}"{{/if}}>{{pool.max}}</span>
              {{/if}}
              <a class="pool-step" data-action="adjustPool" data-ability="{{id}}" data-delta="1"><i class="fas fa-plus"></i></a>
            </div>

            <div class="improvements" data-tooltip="{{localize 'CDG.ui.improvementsHint'}}">
              {{#each (range 1 @root.SYSTEM.ABILITY_MAX_IMPROVEMENTS) as |step|}}
                <span class="bubble {{#if (gte pool.improvements step)}}filled{{/if}}"></span>
              {{/each}}
            </div>
          </li>
        {{/with}}
      {{/each}}
    </ol>

      <div class="passion-block">
        <div class="passion-label" data-tooltip="{{localize 'CDG.ui.passionHint'}}" data-tooltip-direction="UP">{{localize "CDG.label.long.passion"}}</div>
        <div class="tokens">
          <a data-action="adjustPassion" data-delta="-1" data-tooltip="{{localize 'CDG.ui.spendPassion'}}"><i class="fas fa-minus"></i></a>
          <span class="token-count">{{passion.tokens}}</span>
          <a data-action="adjustPassion" data-delta="1" data-tooltip="{{localize 'CDG.ui.gainPassion'}}"><i class="fas fa-plus"></i></a>
        </div>
        <div class="tokens">
        <a class="clear-token" data-action="clearInvokedTraits" data-tooltip="{{localize "CDG.ui.clearInvokedTraits"}}"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
      </div>
  </section>
</header>
