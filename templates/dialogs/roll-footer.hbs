<footer class="roll-footer">
  <div class="roll-state {{status.level}}">
    {{#if (eq status.level "warn")}}<i class="fa-solid fa-triangle-exclamation" inert></i>
    {{else if (eq status.level "good")}}<i class="fa-solid fa-star" inert></i>
    {{else}}<i class="fa-solid fa-check" inert></i>{{/if}}
    <span>{{status.message}}</span>
  </div>

  <div class="controls">
    <button type="button" class="cancel" data-action="cancel">{{localize "CDG.roll.cancel"}}</button>
    <button type="button" class="launch" data-action="roll">
      <i class="fa-solid fa-dice-d20" inert></i> {{localize "CDG.roll.launch"}}
    </button>
  </div>
</footer>
