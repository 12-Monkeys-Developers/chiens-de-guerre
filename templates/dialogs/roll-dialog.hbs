{{!
  Fenêtre de test. Les quatre premières étapes du test (p. 40) de haut en bas : le couple
  caractéristique / compétence, la difficulté annoncée par le Meneur, l'effort, la passion.
  Le bandeau de synthèse ferme la fenêtre en montrant le seuil et son détail complet.
}}
{{! Un PART doit rendre un seul élément racine : d'où l'enveloppe. }}
<div class="roll-body">

  {{#if target}}
    <div class="roll-target">
      <img class="target-image" src="{{target.img}}" alt="{{target.name}}" />
      <span class="target-name">{{localize "CDG.roll.target"}} <strong>{{target.name}}</strong></span>
    </div>
  {{/if}}

  <section class="roll-pair">
    <h2 class="section-title">{{localize "CDG.roll.pair"}}</h2>

    <ol class="ability-choice">
      {{#each abilities as |ability|}}
        <li>
          <button type="button" class="ability {{#if ability.selected}}selected{{/if}}" data-action="setAbility" data-ability="{{ability.id}}" {{#if @root.lockedPair}}disabled{{/if}}>
            <span class="ability-name">{{ability.name}}</span>
            <span class="ability-score">{{ability.pool.value}} <span class="max">/ {{ability.pool.max}}</span></span>
          </button>
        </li>
      {{/each}}
    </ol>

    <div class="field-line skill-line">
      <label for="cdg-roll-skill">{{localize "CDG.roll.skill"}}</label>
      {{#if lockedPair}}
        <strong>{{#if testLabel}}{{testLabel}}{{else if skill}}{{localize skill.label}}{{else}}{{localize "CDG.roll.noSkill"}}{{/if}}</strong>
      {{else}}
        <select id="cdg-roll-skill" name="skillId">
          {{selectOptions skillChoices selected=draft.skillId blank=(localize "CDG.roll.noSkill") valueAttr="id" labelAttr="label"}}
        </select>
      {{/if}}
      <span class="hint handful" data-tooltip="{{rankHint}}">{{rankName}} — {{rankEntry.formula}}</span>
    </div>
  </section>

  <section class="roll-modifiers">
    <h2 class="section-title">{{localize "CDG.roll.modifiers"}}</h2>

    <div class="field-line">
      <label for="cdg-roll-difficulty">{{localize "CDG.roll.difficulty"}}</label>
      <select id="cdg-roll-difficulty" name="difficulty">
        {{selectOptions difficultyChoices selected=draft.difficulty valueAttr="id" labelAttr="label"}}
      </select>
      <label class="inline" for="cdg-roll-modifier">{{localize "CDG.roll.freeModifier"}}</label>
      <input id="cdg-roll-modifier" class="free-modifier" type="number" name="modifier" value="{{draft.modifier}}" step="1" data-dtype="Number" />
    </div>

    <div class="field-line effort-line">
      <label>{{localize "CDG.roll.effort"}}</label>
      <div class="effort-steps" data-tooltip="{{localize 'CDG.roll.hint.effort'}}">
        {{#each effortSteps as |step|}}
          <button type="button" class="effort-step {{#if step.selected}}selected{{/if}}" data-action="setEffort" data-value="{{step.value}}" {{disabled step.disabled}}>
            {{#if step.value}}{{signed step.bonus}}{{else}}{{localize "CDG.roll.noEffort"}}{{/if}}
          </button>
        {{/each}}
      </div>
      {{#if (eq effortMax 0)}}<span class="hint warning">{{localize "CDG.roll.hint.noEffortLeft"}}</span>{{/if}}
    </div>

    {{#if passion.available}}
      <div class="field-line passion-line">
        <label for="cdg-roll-passion">{{localize "CDG.roll.passion"}}</label>
        <select id="cdg-roll-passion" name="passionPairId">
          {{selectOptions passion.choices selected=draft.passionPairId blank=(localize "CDG.roll.noPassion") valueAttr="id" labelAttr="option"}}
        </select>

        <div class="passion-modes">
          <button type="button" class="passion-mode {{#if (eq passion.mode 'bonus')}}selected{{/if}}" data-action="setPassionMode" data-mode="bonus"
            {{disabled (not passion.canSpend)}} data-tooltip="{{localize 'CDG.roll.hint.passionBonus'}}">
            <i class="fa-solid fa-fire" inert></i> {{localize "CDG.roll.passionBonus"}}
          </button>
          <button type="button" class="passion-mode {{#if (eq passion.mode 'malus')}}selected{{/if}}" data-action="setPassionMode" data-mode="malus"
            data-tooltip="{{localize 'CDG.roll.hint.passionMalus'}}">
            <i class="fa-solid fa-fire-flame-simple" inert></i> {{localize "CDG.roll.passionMalus"}}
          </button>
        </div>

        <span class="hint tokens">{{localize "CDG.roll.tokens"}} {{passion.tokens}}</span>
      </div>
    {{/if}}

    {{#if modifiers.length}}
      <ul class="auto-modifiers">
        {{#each modifiers as |modifier|}}
          <li class="auto-modifier {{#unless modifier.active}}off{{/unless}}">
            <button type="button" class="toggle" data-action="toggleModifier" data-id="{{modifier.id}}" data-active="{{modifier.active}}" data-tooltip="{{modifier.hint}}">
              <i class="fa-solid {{#if modifier.active}}fa-square-check{{else}}fa-square{{/if}}" inert></i>
              <span class="label">{{modifier.label}}</span>
              <span class="value">{{signed modifier.value}}</span>
            </button>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  </section>

  <section class="roll-summary">
    <div class="sr">
      <span class="sr-label">{{localize "CDG.roll.sr"}}</span>
      <span class="sr-value">{{sr}}</span>
    </div>
    <ul class="breakdown">
      {{#each parts as |part|}}
        <li class="part {{#if part.base}}base{{/if}}">
          <span class="part-label">{{part.label}}</span>
          <span class="part-value">{{#if part.base}}{{part.value}}{{else}}{{signed part.value}}{{/if}}</span>
        </li>
      {{/each}}
    </ul>
    <p class="handful-hint">
      <i class="fa-solid fa-dice-d20" inert></i>
      {{rankEntry.formula}} —
      {{#if (eq rankEntry.keep "best")}}{{localize "CDG.roll.willKeepBest"}}
      {{else if (eq rankEntry.keep "worst")}}{{localize "CDG.roll.willImpose"}}
      {{else}}{{localize "CDG.roll.singleDie"}}{{/if}}
    </p>
  </section>

</div>
