<li data-index="{{index}}" class="cdg-situational-change">
  <div class="situation">
    {{formInput situationField name=change.situationPath value=change.situation choices=situations
                blank=(localize "CDG.effect.anySituation")}}
  </div>
  <div class="type">
    {{formInput fields.type name=change.typePath value=change.type choices=changeTypes}}
  </div>
  <div class="value">
    {{formInput fields.value name=change.valuePath value=change.value elementType="input"}}
  </div>

  {{!-- Un bonus circonstanciel ne vise aucun champ de la fiche : la clé est constante, la phase
        sans objet puisque le change n'est jamais appliqué. Les deux restent soumis pour que le
        formulaire renvoie un change complet. --}}
  <input type="hidden" name="{{change.keyPath}}" value="{{change.key}}">
  <input type="hidden" name="{{change.phasePath}}" value="{{change.phase}}">

  <div class="priority">
    {{formInput fields.priority name=change.priorityPath value=change.priority placeholder=defaultPriority}}
  </div>
  <div class="controls">
    <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteChange"></button>
  </div>
</li>
