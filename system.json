{
  "id": "chiens-de-guerre",
  "title": "Chiens de guerre",
  "description": "Le système Chiens de guerre pour Foundry VTT.",
  "url": "#{URL}#",
  "version": "#{VERSION}#",
  "compatibility": {
    "minimum": "14",
    "maximum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Christophe Laudon"
    }
  ],
  "esmodules": ["cdg.mjs"],
  "styles": ["css/cdg.css"],
  "packs": [],
  "languages": [
    {
      "lang": "fr",
      "name": "French",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": { "htmlFields": ["specialTraits", "details.biography.private", "details.biography.public", "details.notes.private", "details.notes.public"] },
      "adversaire": { "htmlFields": ["details.description", "details.notes"] }
    },
    "Item": {
      "equipment": { "htmlFields": ["description"] },
      "arcanum": { "htmlFields": ["description", "effect"] },
      "feature": { "htmlFields": ["description"] },
      "peuple": { "htmlFields": ["description"] },
      "carriere": { "htmlFields": ["description"] }
    }
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["lang/", "assets/", "templates/", "css/"]
    }
  },
  "grid": {
    "distance": 1.5,
    "units": "m",
    "type": 0
  },
  "media": [
    {
      "type": "cover",
      "thumbnail": "systems/chiens-de-guerre/assets/images/logos/thumbnail-cdg.webp",
      "loop": false,
      "flags": {}
    },
    {
      "type": "setup",
      "loop": false,
      "thumbnail": "systems/chiens-de-guerre/assets/images/logos/thumbnail-cdg.webp",
      "flags": {}
    }
  ],
  "socket": false,
  "initiative": "1d20",
  "background": "systems/chiens-de-guerre/assets/images/logos/thumbnail-cdg.webp",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#"
}
