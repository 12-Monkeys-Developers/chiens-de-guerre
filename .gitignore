# Node Modules
node_modules/

# Foundry VTT
# Les compendiums compilés seulement : la barre oblique initiale limite le motif à la racine, sans
# quoi il attraperait aussi src/packs, où vivent les sources YAML qui, elles, sont versionnées.
/packs/
styles/**/*.css

# Matière première : PDF des règles, fiche de personnage, images extraites.
# Les visuels réellement utilisés par le système sont copiés dans ui/, qui est versionné.
source/

# Outillage local de génération : données sources, scripts et macros produites pour les
# compendiums et les prétirés. Tout est reconstructible depuis le livre des règles.
/tools/scripts/

# Images des personnages prétirés : les prétirés ne sont pas distribués avec le système.
/assets/images/pretires/

# Tools
.claudeignore
CLAUDE.md
.claude/
