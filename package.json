{
  "name": "chiens-de-guerre",
  "version": "1.0.0",
  "description": "CSS compiler for the Chiens de guerre system",
  "type": "module",
  "scripts": {
    "build": "gulp",
    "compile": "gulp css",
    "lint": "eslint .",
