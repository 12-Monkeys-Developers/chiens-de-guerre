    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "js-yaml": "^4.1.0",
    "less": "^4.1.3",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "gulp": "^5.0.1",
    "gulp-less": "^5.0.0"
